---
const { data } = Astro.props;
---

<div class="pt-12 pb-6 my-3 border-b">
    <a class="block md:pl-6" href={data.link} target="_blank">

        <div class={`grid gap-4 ${data.thumbnail ? 'md:grid-cols-[2fr_1fr]' : 'md:grid-cols-1'}`}>

            <div>
                <h1 class="mb-2 text-2xl leading-6 underline md:leading-8 md:text-4xl font-balthazar">
                    {data.title}
                </h1>

                <div class="flex flex-col gap-4 md:flex-row">
                    <p class="w-full mb-2 text-sm md:w-40 shrink-0">
                        Publié sur <span class="font-bold">{data.publishedon}</span> le {data.date}
                    </p>

                    <div class="flex-1 py-3 leading-relaxed md:p-6">
                        {data.text}
                    </div>
                </div>
            </div>

            {data.thumbnail && (
                <div class="flex items-center justify-center">
                    <a
                    href={data.pdf}
                    target="_blank"
                    rel="noopener noreferrer"
                    >
                   
                    <img
                        src={data.thumbnail}
                        alt={data.title}
                        class="object-cover max-h-48"
                        />
                    </a>
                </div>
            )}

        </div>
    </a>
</div>